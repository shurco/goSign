#!/usr/bin/env bash

# Regenerates Go code from proto files (server <-> worker gRPC contract).
# Requires: protoc, protoc-gen-go, protoc-gen-go-grpc
#   brew install protobuf
#   go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
#   go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

set -euo pipefail
IFS=$'\n\t'

ROOT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="${PATH}:$(go env GOPATH)/bin"

protoc \
  --proto_path="${ROOT_PATH}" \
  --go_out="${ROOT_PATH}" --go_opt=paths=source_relative \
  --go-grpc_out="${ROOT_PATH}" --go-grpc_opt=paths=source_relative \
  "${ROOT_PATH}/internal/rpc/workerv1/worker.proto"

echo "proto: generated internal/rpc/workerv1/*.pb.go"

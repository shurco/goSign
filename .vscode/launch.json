{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "envFile": "${workspaceFolder}/cmd/server/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "worker",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/worker",
      "envFile": "${workspaceFolder}/cmd/server/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "frontend (web/private)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/web/private",
      "console": "integratedTerminal"
    },
    {
      "name": "exp/pdf-cert",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/exp/pdf-cert",
      "cwd": "${workspaceFolder}/exp/pdf-cert"
    },
    {
      "name": "exp/cert",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/exp/cert",
      "cwd": "${workspaceFolder}/exp/cert"
    }
  ],
  "compounds": [
    {
      "name": "gosign (server + worker)",
      "configurations": ["server", "worker"],
      "stopAll": true
    }
  ]
}

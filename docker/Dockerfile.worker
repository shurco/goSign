# syntax=docker/dockerfile:1
# goSign background worker (cmd/worker): Adobe trust lists + GeoLite2 updates.

### Build stage
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY cmd/worker ./cmd/worker
COPY internal ./internal
COPY pkg ./pkg

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/gosign-worker ./cmd/worker

### Runtime stage
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S gosign && adduser -S -G gosign gosign

WORKDIR /app

COPY --from=builder /out/gosign-worker /app/gosign-worker

RUN chown -R gosign:gosign /app

USER gosign

ENTRYPOINT ["/app/gosign-worker"]

# syntax=docker/dockerfile:1
# goSign web app (SvelteKit SPA) served by unprivileged nginx on :8080.
# The API base URL is injected at container start via GOSIGN_API_URL
# (docker-entrypoint.d regenerates config.js), so one image fits any domain.

FROM oven/bun:1.3-alpine AS builder

WORKDIR /app/web/private

COPY web/private/package.json web/private/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

COPY web/private ./
RUN bun run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 docker/frontend-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=builder --chown=nginx:nginx /app/web/private/dist /usr/share/nginx/html

EXPOSE 8080

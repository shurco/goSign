# Docker Compose Project Configuration
COMPOSE_PROJECT_NAME=gosign

# PostgreSQL Configuration
POSTGRES_USER=goSign
POSTGRES_DB=goSign
POSTGRES_PASSWORD=change_me_in_production
# Host for ./scripts/migration (compose.dev.yaml maps postgres to localhost:5452)
POSTGRES_HOST=localhost:5452

# Redis Configuration
REDIS_PASSWORD=change_me_in_production

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production

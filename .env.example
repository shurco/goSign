# Docker Compose Project Configuration
COMPOSE_PROJECT_NAME=gosign

# Public domains (docker compose stack).
# API is served on API_DOMAIN (paths /v1, /drive, /embed, /health),
# the web app SPA on APP_DOMAIN. *.localhost resolves to 127.0.0.1 in browsers.
API_DOMAIN=api.localhost
APP_DOMAIN=app.localhost
# Scheme used to build public URLs (http or https, TLS terminates upstream)
PUBLIC_SCHEME=http

# Backend Configuration (required for server/worker via launch.json or CLI)
GOSIGN_JWT_SECRET=change_me_in_production
GOSIGN_DEV_MODE=true
GOSIGN_HTTP_ADDR=0.0.0.0:8088
# compose.dev.yaml maps postgres to localhost:5452 (not the default 5432)
GOSIGN_POSTGRES_URL=postgres://goSign:change_me_in_production@localhost:5452/goSign?pool_max_conns=10
GOSIGN_REDIS_ADDRESS=localhost:6379
GOSIGN_REDIS_PASSWORD=change_me_in_production
# Vite dev server (bun run dev); use http://app.localhost when behind docker nginx
GOSIGN_APP_URL=http://localhost:5173

# PostgreSQL Configuration (used by compose.dev.yaml and ./scripts/migration)
POSTGRES_USER=goSign
POSTGRES_DB=goSign
POSTGRES_PASSWORD=change_me_in_production
# Host for ./scripts/migration (compose.dev.yaml maps postgres to localhost:5452)
POSTGRES_HOST=localhost:5452

# Redis Configuration
REDIS_PASSWORD=change_me_in_production

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
